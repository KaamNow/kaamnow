# Backend Dockerfile — FastAPI on Python 3.11 (multi-arch: amd64 + arm64)
FROM python:3.11-slim

WORKDIR /app

# Install build deps (gcc only needed if any native wheels missing for our arch)
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Install only production deps. We use requirements.prod.txt (lean) instead of
# requirements.txt (which contains dev tools + Emergent-internal libs not on PyPI).
COPY backend/requirements.prod.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy app source (AFTER deps for better layer caching)
COPY backend/server.py ./server.py

# Non-root user
RUN useradd -m -u 1000 app && chown -R app:app /app
USER app

EXPOSE 8001

# Healthcheck — used by Docker; k8s uses its own probes from the manifest
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8001/api/stats || exit 1

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]
