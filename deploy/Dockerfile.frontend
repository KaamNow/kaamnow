# Frontend Dockerfile — multi-stage. React build → tiny nginx image.
FROM node:20-alpine AS builder

WORKDIR /build

# Copy lockfile if present (handles both fresh + existing repos)
COPY frontend/package.json ./
COPY frontend/yarn.lock ./yarn.lock

# Install deps. Use --network-timeout for slow CI / ARM environments.
RUN yarn install --frozen-lockfile --network-timeout 600000

# Copy the rest of the frontend
COPY frontend/ ./

# REACT_APP_BACKEND_URL is set at build time. Empty string makes API calls relative
# (e.g. /api/...) — same-origin via the ingress to the backend service.
ARG REACT_APP_BACKEND_URL=""
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL
ENV ENABLE_HEALTH_CHECK=false
# CI=false: CRA treats CI=true as "warnings = errors" which breaks the build on
# benign eslint warnings. We don't want that in Docker. Lint runs separately in dev.
ENV CI=false
ENV GENERATE_SOURCEMAP=false

RUN yarn build

# --- Runtime: tiny nginx image
FROM nginx:1.27-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /build/build /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
